{
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":semanticCommits",
    "workarounds:javaLTSVersions"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackageNames": [
        "**"
      ],
      "allowedVersions": "!/\\-SNAPSHOT$/",
      "matchDatasources": [
        "maven"
      ]
    },
    {
      "matchDatasources": [
        "java-version"
      ],
      "matchPackageNames": [
        "java-jdk"
      ],
      "groupName": "Java LTS",
      "groupSlug": "java-lts",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.gradle\\.kts$/",
        "/(^|/)gradle-daemon-jvm\\.properties$/"
      ],
      "matchStrings": [
        "JavaLanguageVersion\\.of\\((?<currentValue>\\d+)\\)",
        "UpgradeToJava(?<currentValue>\\d+)",
        "toolchainVersion=(?<currentValue>\\d+)"
      ],
      "depNameTemplate": "java-jdk",
      "datasourceTemplate": "java-version",
      "versioningTemplate": "java"
    }
  ]
}
